# Environment variables for Real Estate Price Prediction System
# Copy this file to .env and fill in your values
# Note: For demo/testing, RAPIDAPI_KEY is optional (project works with existing data)

# Database Configuration (defaults work for local development)
POSTGRES_DB=real_estate
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops123

# RapidAPI Configuration (optional - only needed for data collection)
# Get your API key from: https://rapidapi.com/3b-data-3b-data-default/api/airbnb19
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=airbnb19.p.rapidapi.com

# Data Collection Settings (optional - only needed for new data collection)
PLACE_ID=your_place_id_here
MAX_LISTINGS=4120
MAX_IMAGES_PER_LISTING=20

# Logging
LOG_LEVEL=INFO

# Data Directory (default for Docker)
DATA_DIR=/app/data
